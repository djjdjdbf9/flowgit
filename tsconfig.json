{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "baseUrl": ".",
    "paths": {
      "@/*": ["src/*"],
      "@shared/*": ["shared/*"]
    },
    "resolveJsonModule": true,
    "types": ["vite/client"]
  },
  "include": ["src/**/*", "shared/**/*"],
  "exclude": ["node_modules", "dist", "dist-electron", "electron"]
}
